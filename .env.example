# Optional settings for SentinelWeb. Copy this file to .env and fill in your own values. Never commit .env.
#   Linux/macOS:  cp .env.example .env
#   Windows:      copy .env.example .env
# Docker Compose reads this .env too. Without it everything still works with defaults.

# ---- AI answers in the Sentinel assistant (optional) ----
# You can also add the key on the dashboard's Settings page; values saved there win over this file.
# Your free API key from Google AI Studio (aistudio.google.com) or Groq (console.groq.com)
LLM_API_KEY=

# gemini or groq
LLM_PROVIDER=gemini

# Model name. Free model names change - if the assistant stops using AI, check the provider's model list.
LLM_MODEL=gemini-3.5-flash-lite

# ---- Detection (optional) ----
# 1 = block high-severity requests (default), 0 = flag-only mode (nothing is blocked)
# SENTINEL_BLOCK=1
